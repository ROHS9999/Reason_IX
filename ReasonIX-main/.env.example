GROQ_API_KEY=your_key_here

# optional
# LLM_MODEL=openai/gpt-oss-20b
# VERIFY_MODEL=openai/gpt-oss-120b
# ALLOWED_ORIGINS=http://localhost:5173
# GUARD_MODE=filter        # filter | flag | off  (hallucination guard)
# TAVILY_API_KEY=tvly-...  # optional web-search provider; without it the keyless `ddgs` package is used
# Langfuse tracing (https://langfuse.com, free cloud tier)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
